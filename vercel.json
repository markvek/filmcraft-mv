{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "grok_orchestrator": {
      "root": "deploy/grok-orchestrator",
      "functions": {
        "api/**/*.js": {
          "runtime": "nodejs20.x"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "grok_orchestrator"
      }
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}

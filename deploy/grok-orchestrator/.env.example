# Server-side credentials. Set these in Vercel Project Settings, not in git.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key
VERTICALFLASH_URL=https://your-verticalflash-host.example
VERTICALFLASH_TOKEN=your-verticalflash-token

# Password Grok must send to call protected routes.
# Accepted as:
#   Authorization: Bearer <value>
#   x-orchestrator-password: <value>
#   Basic auth password
ORCHESTRATOR_PASSWORD=choose-a-long-random-password

# Optional. If unset, /api/jobs reuses the latest requested_by user it can find for the workspace.
PROCESSING_JOB_REQUESTED_BY=

# Optional project defaults for the Super Sauced pilot.
SUPER_SAUCED_WORKSPACE_ID=79780694-67c4-4e98-9e58-49eb076bbc6e
SUPER_SAUCED_PROJECT_NAME=Super Sauced
SUPABASE_MEDIA_BUCKET=project-media

# Optional: require a distinct password just for Super Sauced routes.
# If unset, ORCHESTRATOR_PASSWORD is used.
SUPER_SAUCED_PASSWORD=

# Local Mac worker only. These are not needed on Vercel.
FILMCRAFT_CLI_PATH=/absolute/path/to/filmcraft-cli
FILMCRAFT_WORK_DIR=/Users/you/FilmCraftWorker
FILMCRAFT_WORKER_ID=your-mac-name
FILMCRAFT_WORKER_RENDER_FIRST_PASS=false
FILMCRAFT_WORKER_INTERVAL_MS=5000
FILMCRAFT_WORKER_LEASE_SECONDS=900
